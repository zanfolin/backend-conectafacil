{
  "name": "backend-conectafacil",
  "version": "1.0.0",
  "description": "API REST ConectaFácil - Node 24 + Express 5 + SQLite nativo",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "migrate:latest": "knex migrate:latest --knexfile knexfile.js",
    "migrate:rollback": "knex migrate:rollback --knexfile knexfile.js",
    "migrate:make": "knex migrate:make --knexfile knexfile.js",
    "seed": "knex seed:run --knexfile knexfile.js",
    "seed:make": "knex seed:make --knexfile knexfile.js",
    "test:smoke": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "dotenv": "^18.0.3",
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3",
    "knex": "3.3.0",
    "multer": "2.4.0",
    "nodemailer": "10.0.10",
    "zod": "4.6.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
