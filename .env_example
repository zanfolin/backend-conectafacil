# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Database
DATABASE_PATH=./data/conectafacil.db

# SMTP (email)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ConectaFácil <noreply@conectafacil.com>"

# Upload
UPLOAD_DIR=./uploads/avatars
MAX_AVATAR_MB=2